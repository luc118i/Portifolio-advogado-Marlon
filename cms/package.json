{
  "name": "cms-marlon",
  "version": "1.0.0",
  "description": "CMS local — Dr. Marlon Inácio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build-exe": "pkg . --compress GZip --output CMS-Marlon.exe"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "multer": "^2.1.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "targets": ["node18-win-x64"],
    "scripts": [
      "routes/**/*.js",
      "lib/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "node_modules/docx/build/**/*",
      "node_modules/multer/**/*"
    ]
  }
}
